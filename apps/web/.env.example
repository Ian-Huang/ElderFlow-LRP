# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Base URL (Azure Functions endpoint)
VITE_API_BASE_URL=https://your-api.azurewebsites.net/api/v1

# Enable Mock API (MSW) for development
VITE_MOCK_API=true

# PWA Configuration
VITE_PWA_ENABLED=true

# Kiosk Mode (for dedicated devices)
VITE_KIOSK_MODE=false